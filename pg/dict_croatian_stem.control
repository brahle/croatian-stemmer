comment = 'text search dictionary for Croatian stemming (Ljubešić-Pandžić algorithm)'
default_version = '1.0'
module_pathname = '$libdir/dict_croatian_stem'
relocatable = true
# Trusted, like contrib's unaccent: a database owner without superuser can
# CREATE EXTENSION it. The install script (C-language template, text search
# template, dictionary and configuration) then runs as the bootstrap superuser.
trusted = true
