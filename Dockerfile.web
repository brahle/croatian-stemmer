FROM node:22.16.0-bookworm-slim@sha256:048ed02c5fd52e86fda6fbd2f6a76cf0d4492fd6c6fee9e2c463ed5108da0e34 AS assets
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev
COPY scripts/build-web-assets.mjs scripts/
RUN npm run build

FROM python:3.14.7-slim-trixie@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/src
WORKDIR /app
COPY requirements-web.txt ./
RUN pip install --no-cache-dir --require-hashes -r requirements-web.txt && useradd --uid 10001 --create-home labeling
COPY src/ src/
COPY --from=assets /build/src/croatian_stemmer/labeling/web/static/vendor/ src/croatian_stemmer/labeling/web/static/vendor/
COPY migrations/ migrations/
COPY alembic.ini ./
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/readyz',timeout=3)"
CMD ["python", "-m", "uvicorn", "croatian_stemmer.labeling.web.serve:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
